{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auto-culling",
  "version": "0.1.0",
  "identifier": "com.autoculling.f1",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Auto-Culling — F1 连拍选片",
        "width": 1420,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "externalBin": ["binaries/cull-sidecar"]
  }
}
